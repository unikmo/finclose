{
  "name": "finclose",
  "version": "0.35.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "rule-accuracy": "node --experimental-strip-types --import ./tests/register-ts-resolve.mjs scripts/rule-accuracy.ts",
    "test:browser": "node --experimental-strip-types --import ./tests/register-ts-resolve.mjs --test tests/browser/*.browser.ts",
    "test": "node --experimental-strip-types --import ./tests/register-ts-resolve.mjs --test tests/*.test.ts",
    "test:emulator": "firebase emulators:exec --only firestore,database,auth,storage --project demo-finclose \"node --experimental-strip-types --import ./tests/register-ts-resolve.mjs --test tests/emulator/*.emulator.ts\""
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "firebase-admin": "^13.4.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "firebase-tools": "^15.34.2",
    "playwright-core": "1.64.1",
    "typescript": "5.7.3"
  }
}
