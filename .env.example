# Vercel server-side Firebase credentials. Never prefix these with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"theantibalcony","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
# Optional override. v0.24 defaults to the current theantibalcony RTDB URL below.
FIREBASE_DATABASE_URL=https://theantibalcony-default-rtdb.europe-west1.firebasedatabase.app/
FINCLOSE_LAB_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TEST_TOKEN
