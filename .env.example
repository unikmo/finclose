# Runtime mode: LAB | PILOT | PRODUCTION
# LAB keeps the synthetic test bridge. PILOT/PRODUCTION disable customer use of the Lab token.
FINCLOSE_RUNTIME_MODE=LAB

# Server-side Firebase credentials. Never prefix these with NEXT_PUBLIC_.
# The same Firebase project provides Authentication, Realtime Database, Cloud Firestore and Storage.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"theantibalcony","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
FIREBASE_DATABASE_URL=https://theantibalcony-default-rtdb.europe-west1.firebasedatabase.app/

# Managed Firebase Authentication client configuration used by PILOT/PRODUCTION account screens.
# These values are Firebase web-app configuration values; they are not service-account secrets.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=theantibalcony.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=theantibalcony
FIREBASE_WEB_APP_ID=

# Cloud Firestore is the authoritative accounting ledger in PILOT/PRODUCTION.
# No PostgreSQL or Supabase credentials are used by FinClose.

# Internal synthetic Lab secret. Used only while FINCLOSE_RUNTIME_MODE=LAB.
FINCLOSE_LAB_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TEST_TOKEN

# Optional external accounting connector provider credentials.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Configure exact least-privilege scopes in the Xero developer app; do not guess them in code.
XERO_SCOPES=

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

DATEV_CLIENT_ID=
DATEV_CLIENT_SECRET=

# SmartAccounts uses company-specific API credentials. A secure customer-secret flow
# is required before those credentials may be accepted or stored.
