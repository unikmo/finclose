# Runtime mode: LAB | PILOT | PRODUCTION
# LAB keeps the synthetic test bridge. PILOT/PRODUCTION disable customer use of the Lab token.
FINCLOSE_RUNTIME_MODE=LAB

# A real-data mode is not activated by FINCLOSE_RUNTIME_MODE alone.
# Keep these BLOCKED until the corresponding independent release gate is actually complete.
FINCLOSE_PILOT_RELEASE_GATE=BLOCKED
FINCLOSE_PRODUCTION_RELEASE_GATE=BLOCKED

# Exact Git source identity for release certification.
# Vercel's VERCEL_GIT_COMMIT_SHA is authoritative when present. Use this fallback only for a manual deployment
# that does not expose Git metadata, and set it to the exact 40-character commit SHA being deployed.
FINCLOSE_RELEASE_SOURCE_SHA=

# Real-data financial uploads are quarantine-first.
# BLOCK = reject real uploads entirely.
# MANUAL_REVIEW = controlled PILOT only; store privately in quarantine and require an authorized ADMIN to clear/reject before use.
# SCANNER = automated quarantine release; production requires this plus FINCLOSE_UPLOAD_SCANNER_VERIFIED=YES.
FINCLOSE_UPLOAD_QUARANTINE_MODE=BLOCK
# Set YES only after the scanner worker and its failure/timeout behavior have been independently verified.
FINCLOSE_UPLOAD_SCANNER_VERIFIED=NO

# Pilot certification manual release attestations.
# Keep NO until each item has actual evidence. Runtime activation remains blocked while any mandatory attestation is NO.
FINCLOSE_BACKUP_PITR_VERIFIED=NO
FINCLOSE_SECURITY_REVIEW_APPROVED=NO
FINCLOSE_ACCOUNTING_QA_APPROVED=NO
FINCLOSE_MANUAL_UPLOAD_PROCEDURE_APPROVED=NO
FINCLOSE_AUTH_EMAIL_DELIVERY_VERIFIED=NO
FINCLOSE_UPLOAD_OPERATOR_CHECKLIST_VERIFIED=NO

# Server-side Firebase credentials. Never prefix these with NEXT_PUBLIC_.
# The same Firebase project provides Authentication, Realtime Database, Cloud Firestore and Storage.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"theantibalcony","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
FIREBASE_DATABASE_URL=https://theantibalcony-default-rtdb.europe-west1.firebasedatabase.app/

# Managed Firebase Authentication client configuration used by PILOT/PRODUCTION account screens and certification.
# These values are Firebase web-app configuration values; they are not service-account secrets.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=theantibalcony.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=theantibalcony
FIREBASE_WEB_APP_ID=

# Cloud Firestore is the authoritative accounting ledger in PILOT/PRODUCTION.
# No PostgreSQL or Supabase credentials are used by FinClose.

# Internal synthetic Lab secret. Used only while FINCLOSE_RUNTIME_MODE=LAB.
# The same internal secret protects the pre-activation pilot-certification endpoint.
FINCLOSE_LAB_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TEST_TOKEN

# Optional external accounting connector provider credentials.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Configure exact least-privilege scopes in the Xero developer app; do not guess them in code.
XERO_SCOPES=

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

DATEV_CLIENT_ID=
DATEV_CLIENT_SECRET=

# SmartAccounts uses company-specific API credentials. A secure customer-secret flow
# is required before those credentials may be accepted or stored.
